    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* =========================================
           VIDARO / FRAMER AGENCY DESIGN SYSTEM
           ========================================= */
        :root {
            --bg-color: #030303;
            --surface-color: #0f0f11;
            --surface-hover: #17171a;
            --border-color: rgba(255, 255, 255, 0.08);
            --border-highlight: rgba(255, 255, 255, 0.15);
            
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa; /* Zinc 400 */
            
            --accent: #8b5cf6;
            --gradient-primary: linear-gradient(135deg, #ffffff 0%, #a1a1aa 100%);
            --gradient-accent: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
            --gradient-glow: rgba(139, 92, 246, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Ambient Glow Background */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            height: 800px;
            background: radial-gradient(circle at 50% 0%, var(--gradient-glow) 0%, rgba(3,3,3,0) 70%);
            z-index: -1;
            pointer-events: none;
        }

        h1, h2, h3, h4 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.02em;
        }

        a {
            text-decoration: none;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* =========================================
           SCROLL ANIMATIONS (Framer Effect)
           ========================================= */
        .animate {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .animate.show {
            opacity: 1;
            transform: translateY(0);
        }
        .delay-1 { transition-delay: 0.1s; }
        .delay-2 { transition-delay: 0.2s; }
        .delay-3 { transition-delay: 0.3s; }

        /* =========================================
           FLOATING NAVBAR
           ========================================= */
        .navbar {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(15, 15, 17, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-color);
            padding: 8px 12px 8px 32px;
            border-radius: 100px;
            width: calc(100% - 48px);
            max-width: 900px;
            z-index: 1000;
        }

        .nav-brand {
            font-family: 'Outfit', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 32px;
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 24px;
            border-radius: 100px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--text-primary);
            color: #000;
            border: 1px solid var(--text-primary);
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255,255,255,0.2);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--border-highlight);
        }

        /* =========================================
           HERO SECTION
           ========================================= */
        .hero {
            padding: 200px 0 120px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .section-tag {
            display: inline-block;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 100px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 32px;
        }

        .hero h1 {
            font-size: clamp(3rem, 6vw, 5.5rem);
            max-width: 900px;
            margin-bottom: 24px;
        }

        .text-gradient {
            background: var(--gradient-accent);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin-bottom: 40px;
        }

        .hero-btns {
            display: flex;
            gap: 16px;
        }

        /* =========================================
           STATS SECTION
           ========================================= */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1000px;
            margin: 0 auto 120px;
            text-align: center;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 60px 0;
            background: rgba(15, 15, 17, 0.3);
        }

        .stat-item h3 {
            font-size: 3.5rem;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .stat-item p {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        /* =========================================
           SERVICES (BENTO GRID)
           ========================================= */
        .section-header {
            text-align: center;
            margin-bottom: 64px;
        }

        .section-header h2 {
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            margin-bottom: 16px;
        }

        .bento-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 160px;
        }

        .bento-card {
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 48px;
            transition: all 0.4s ease;
        }

        .bento-card:hover {
            transform: translateY(-5px);
            border-color: var(--border-highlight);
            background: var(--surface-hover);
        }

        .bento-card i {
            font-size: 2.5rem;
            background: var(--gradient-accent);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 24px;
        }

        .bento-card h3 {
            font-size: 1.5rem;
            margin-bottom: 12px;
        }

        .bento-card p {
            color: var(--text-secondary);
        }

        /* =========================================
           COMPARISON SECTION (Vidaro Style)
           ========================================= */
        .comparison {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 160px;
        }

        .comp-card {
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 48px;
        }

        .comp-card.highlight {
            background: rgba(139, 92, 246, 0.05);
            border: 1px solid rgba(139, 92, 246, 0.3);
            position: relative;
        }

        .comp-card h3 {
            font-size: 2rem;
            margin-bottom: 32px;
            text-align: center;
        }

        .comp-list {
            list-style: none;
        }

        .comp-list li {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
            font-size: 1.1rem;
            color: var(--text-secondary);
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .comp-list li:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .comp-card.highlight .comp-list li {
            color: var(--text-primary);
        }

        .comp-list i.fa-xmark {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
            padding: 6px 8px;
            border-radius: 50%;
        }

        .comp-list i.fa-check {
            color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
            padding: 6px 6px;
            border-radius: 50%;
        }

        /* =========================================
           PROJECTS / WORK SECTION
           ========================================= */
        .projects {
            display: flex;
            flex-direction: column;
            gap: 32px;
            margin-bottom: 160px;
        }

        .project-card {
            display: flex;
            align-items: center;
            gap: 40px;
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 32px;
            padding: 40px;
            transition: all 0.3s ease;
        }

        .project-card:hover {
            border-color: var(--border-highlight);
            background: var(--surface-hover);
        }

        .project-visual {
            width: 250px;
            height: 250px;
            border-radius: 24px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            color: var(--text-secondary);
            flex-shrink: 0;
        }

        .project-info h3 {
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .project-info h4 {
            font-size: 1.1rem;
            color: var(--accent);
            margin-bottom: 24px;
            font-weight: 500;
        }

        .project-info p {
            color: var(--text-secondary);
            margin-bottom: 16px;
            font-size: 1.1rem;
            position: relative;
            padding-left: 20px;
        }

        .project-info p::before {
            content: "•";
            position: absolute;
            left: 0;
            color: var(--text-primary);
        }

        /* =========================================
           FOOTER CTA
           ========================================= */
