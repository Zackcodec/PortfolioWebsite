            background: var(--surface-color);
            border-top: 1px solid var(--border-color);
            padding: 100px 0 40px;
            text-align: center;
            margin-top: 100px;
        }

        .footer-cta h2 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            margin-bottom: 24px;
        }

        .footer-cta p {
            color: var(--text-secondary);
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 40px;
        }
        
        .footer-bottom {
            margin-top: 100px;
            padding-top: 32px;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .nav-links { display: none; }
            .stats { grid-template-columns: 1fr; gap: 40px; }
            .bento-grid, .comparison { grid-template-columns: 1fr; }
            .project-card { flex-direction: column; text-align: center; }
            .project-visual { width: 100%; height: 200px; }
            .project-info p { padding-left: 0; }
            .project-info p::before { display: none; }
            .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
        }
    </style>
</head>
